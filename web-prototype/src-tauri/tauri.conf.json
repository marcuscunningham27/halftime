{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halftime Prototype",
  "version": "0.1.0",
  "identifier": "com.halftime.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Halftime",
        "width": 1000,
        "height": 820,
        "minWidth": 640,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 24,
          "y": 26
        },
        "dragDropEnabled": false,
        "label": "main"
      },
      {
        "label": "tray",
        "url": "/tray",
        "title": "Halftime",
        "visible": false,
        "width": 360,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": true,
        "focus": true,
        "windowEffects": {
          "effects": [
            "popover",
            "acrylic"
          ],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
